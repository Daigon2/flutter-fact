<?xml version="1.0" encoding="utf-8"?>
<!--
  Wortgleich mit values/styles.xml, und das ist beabsichtigt: der erste
  Bildschirm dieser App ist dunkel, gleich wie der Dunkelmodus des
  Betriebssystems steht. Die Begründung der Werte steht in values/styles.xml,
  die Begründung der Farbe in values/colors.xml.

  Vorher unterschieden sich die beiden Dateien: values/ erbte von
  `Theme.Light.NoTitleBar`, values-night/ von `Theme.Black.NoTitleBar`. Der
  weiße Startbildschirm trat deshalb nur im hellen Systemmodus auf, und wer im
  Dunkelmodus prüft, sieht den Defekt nicht.

  Die Datei bleibt bestehen: Android würde im Dunkelmodus auch ohne sie auf
  values/ zurückfallen und zum selben Ergebnis kommen, das Entfernen ist also
  eine eigene Aufräum-Entscheidung. Wer eine der beiden Dateien ändert, muss
  die andere mit ansehen.
-->
<resources>
    <!-- Bis der Flutter-Prozess läuft. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Ab dem Start des Prozesses, und danach hinter der laufenden App. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/fact_splash_background</item>
    </style>
</resources>
